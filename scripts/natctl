#!/bin/sh
# natctl — nat-doctor control + watchdog for Asuswrt-Merlin.
#
# THE FAULT (stock AsusWRT — Merlin and stock are equally affected):
# a WAN link flap SHORTER than the dual-WAN failover threshold
# (wandog_interval x wandog_maxfail) never reaches `wanduck`. It is handled
# instead by udhcpc's lightweight re-init path, which serialises through a
# single-slot rc_service queue. With only a few seconds between the down and
# up events the two sequences collide, a service wedges on stop (stop_ntpd in
# every case observed so far), rc force-aborts it, and EVERYTHING THE CASCADE
# HAD NOT YET DONE NEVER HAPPENS.
#
# The WAN-up cascade is a sequence of stop/start pairs, roughly:
#   nat-start -> firewall-start -> ntpd -> WireGuard server -> samba
#   -> dnsmasq -> DDNS -> dhcp renew
# A wedge strands whatever pair it died inside, so the damage varies per
# incident. Observed on one RT-BE92U:
#   2026-09-13 - died after WireGuard restarted: NAT rules missing
#   2026-09-22 - died after "WireGuard: Stopping server": NAT rules missing
#                AND the wgs1 interface never came back (total VPN lockout)
#
# The router is left healthy by every measure it has — state_t=2, GUI green,
# its own traffic and DNS fine — while clients are cut off. Nothing retries.
#
# WHY A WATCHDOG IS THE ONLY ANSWER: the dual-WAN health check probes
# wandog_target FROM THE ROUTER, which is genuinely fine throughout. No
# router-originated probe of any kind can detect this. Only inspecting the
# resulting state works.
#
# DESIGN RULE: when in doubt, do nothing. Every check answers THREE
# questions, and only acts when all three are unambiguous:
#   should_run  - what the router's own config DECLARES (nvram)
#   is_ok       - observable reality
#   enabled     - whether the operator wants us watching this (HEAL_CHECKS)
# If should_run cannot be determined, that is a SKIP. A service the user has
# deliberately disabled must never be "repaired" — that would fight their
# configuration every minute forever.

VERSION=0.3.0
TAG=nat-doctor

# --- paths -----------------------------------------------------------------
# Runtime state lives in /tmp (RAM): never wear JFFS flash with routine writes.
# ONE thing must survive a reboot — the escalated-reboot timestamp — or an
# escalation that reboots into the same fault could loop. Written at most once
# per REBOOT_MIN_GAP, so not a flash-wear concern.
RUN=/tmp/nat-doctor
PERSIST_REBOOT=/jffs/scripts/nat-doctor.reboot
REBOOT_FLAG=/jffs/scripts/nat-doctor.reboot-ok
# Durable record of repairs. `logger` goes to syslog, which rotates in about a
# day on a busy router — so a heal at 3am could be gone before anyone looks,
# and the watchdog would have no way to show it ever did anything. This file
# is the second exception to "no routine writes to /jffs": it is appended ONLY
# when a repair actually happens (never on a healthy check), and trimmed to
# HISTORY_MAX lines. In normal operation that is a handful of lines a month.
HISTORY=/jffs/scripts/nat-doctor.history
HISTORY_MAX=200
CONF=/jffs/scripts/nat-doctor.conf
LOCK="$RUN/lock"
# Overridable ONLY so tests/ can stub the netdev namespace.
NETDEV_ROOT=${NETDEV_ROOT:-/sys/class/net}

# --- tunables (override in $CONF; the installer must never write that file) --
# Which checks are active. Defaults are the three with confirmed failure
# modes; the rest are opt-in because every extra check is another thing that
# can misfire. Available: firewall wireguard dnsmasq samba ntpd upnp
HEAL_CHECKS="firewall wireguard dnsmasq"

COOLDOWN=300            # min seconds between repair attempts, PER CHECK
MAXHEALS=3              # max repairs per WINDOW per check, then stand down
WINDOW=3600
RECHECK_WAIT=30         # let a repair settle before re-checking
REBOOT_MIN_GAP=21600    # 6h minimum between escalated reboots

# Bounds on a single run. These exist because our repairs call `service`,
# which goes through notify_rc into the SAME rc_service queue whose wedging
# causes this fault. If we ever repair while that queue is stuck, the call can
# hang forever — and a hung run holding the lock means the watchdog silently
# stops protecting anything. Never remove these.
REPAIR_TIMEOUT=60       # hard kill a repair command that hangs this long
MAX_RUN=240             # abandon the whole run after this many seconds
LOCK_STALE=600          # a lock older than this means the holder is hung

[ -f "$CONF" ] && . "$CONF"

mkdir -p "$RUN" 2>/dev/null

log() { logger -t "$TAG" "$*"; [ -n "$NATDOC_VERBOSE" ] && echo "$TAG: $*" >&2; }

# hist <check> <event> <detail...> — append one line to the durable history and
# trim. Call ONLY for things worth surviving a syslog rotation: repairs and
# their outcomes, escalations, stand-downs. Never for a healthy check.
hist() {
	_hc="$1"; _he="$2"; shift 2
	printf '%s\t%-9s %-16s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$_hc" "$_he" "$*" >> "$HISTORY" 2>/dev/null || return 0
	# Trim in place. Rare enough (repairs only) that a full rewrite is fine.
	_hl=$(wc -l < "$HISTORY" 2>/dev/null || echo 0)
	if [ "$_hl" -gt "$HISTORY_MAX" ] 2>/dev/null; then
		tail -n "$HISTORY_MAX" "$HISTORY" > "$HISTORY.tmp" 2>/dev/null && mv "$HISTORY.tmp" "$HISTORY"
	fi
}

say() { echo "$*"; }
now() { date +%s; }
read_ts() { [ -f "$1" ] && cat "$1" 2>/dev/null || echo 0; }
have_proc() { [ -n "$(pidof "$1" 2>/dev/null)" ]; }

# run_limited <seconds> <command...> — busybox has no `timeout` applet, so
# supervise it by hand. Returns 124 if the command had to be killed.
# Killing our `service` invocation does not unwedge rc_service, but it frees
# the watchdog, which is the whole point.
run_limited() {
	_lim="$1"; shift
	"$@" &
	_rp=$!
	_i=0
	while [ "$_i" -lt "$_lim" ]; do
		kill -0 "$_rp" 2>/dev/null || { wait "$_rp"; return $?; }
		sleep 1
		_i=$((_i + 1))
	done
	log "TIMEOUT: repair command exceeded ${_lim}s — killing pid $_rp (rc_service may be wedged)"
	kill -TERM "$_rp" 2>/dev/null
	sleep 2
	kill -KILL "$_rp" 2>/dev/null
	return 124
}

# Seconds since this run started; used to enforce MAX_RUN.
RUN_START=$(date +%s)
run_elapsed() { echo $(( $(date +%s) - RUN_START )); }

# Every repair goes through here, so every repair is bounded.
svc() { run_limited "$REPAIR_TIMEOUT" service "$1" >/dev/null 2>&1; }

# ===========================================================================
# CHECK: firewall — the NAT rule set
# ===========================================================================
#
# NEVER hardcode an interface. During a failover to the secondary WAN the
# active unit may be PPP (pppoe over a USB dongle), where NAT lives on pppN,
# not on the primary's ethN. A check hardcoded to the primary would see "no
# MASQUERADE" and restart the firewall EVERY MINUTE for the entire duration of
# a genuine outage. The most safety-critical function in this script.
active_unit() {
	_u=$(nvram get wan_primary 2>/dev/null)
	case "$_u" in 0|1) echo "$_u"; return 0 ;; esac
	for _u in 0 1; do
		[ "$(nvram get wan${_u}_primary 2>/dev/null)" = "1" ] && { echo "$_u"; return 0; }
	done
	return 1
}

# Echo the netdev carrying NAT for unit $1, or return 1 if it cannot be
# determined with confidence (the caller must then SKIP, never repair).
active_ifname() {
	_u="$1"
	case "$(nvram get wan${_u}_proto 2>/dev/null)" in
		pppoe|pptp|l2tp)
			# For PPP the netdev is pppN, published once the link is up.
			# Empty while down — a skip, not a fault.
			_if=$(nvram get wan${_u}_pppoe_ifname 2>/dev/null) ;;
		*)
			_if=$(nvram get wan${_u}_ifname 2>/dev/null) ;;
	esac
	# A serial device is not a network interface: wan1_ifname is /dev/ttyUSB0
	# on USB-dongle setups. Reject anything that is not a real netdev.
	case "$_if" in ""|/dev/*) return 1 ;; esac
	[ -e "$NETDEV_ROOT/$_if" ] || return 1
	echo "$_if"
}

masq_present() { iptables -t nat -S POSTROUTING 2>/dev/null | grep -q -- "-o $1 -j MASQUERADE"; }
vserver_rule_count() { _n=$(iptables -t nat -S VSERVER 2>/dev/null | grep -c '^-A'); echo "${_n:-0}"; }
forwards_configured() {
	[ "$(nvram get vts_enable_x 2>/dev/null)" = "1" ] || return 1
	[ -n "$(nvram get vts_rulelist 2>/dev/null)" ] || return 1
	return 0
}

# should_run: 0 = yes, 1 = no (intentionally), 2 = cannot tell
should_run_firewall() {
	unit=$(active_unit) || { SR_WHY="cannot determine active WAN unit"; return 2; }
	_st=$(nvram get wan${unit}_state_t 2>/dev/null)
	[ "$_st" = "2" ] || { SR_WHY="wan${unit}_state_t=$_st (WAN not connected) — rules legitimately absent"; return 1; }
	ifname=$(active_ifname "$unit") || { SR_WHY="cannot determine netdev for wan$unit"; return 2; }
	return 0
}

is_ok_firewall() {
	if ! masq_present "$ifname"; then
		OK_WHY="wan$unit connected on $ifname but no MASQUERADE in POSTROUTING"; return 1
	fi
	if forwards_configured && [ "$(vserver_rule_count)" = "0" ]; then
		OK_WHY="wan$unit on $ifname, MASQUERADE present, but VSERVER empty while port forwarding is enabled"; return 1
	fi
	OK_WHY="wan$unit on $ifname, MASQUERADE present, VSERVER $(vserver_rule_count) rules"
	return 0
}

repair_firewall() { svc restart_firewall; }

# ===========================================================================
# CHECK: wireguard — the WireGuard *server*
# ===========================================================================
# 2026-09-22: the cascade died at "WireGuard: Stopping server" with no
# matching start, leaving wgs1 nonexistent and the operator locked out.
# restart_firewall does NOT fix this — it rebuilds iptables, not interfaces.
wgs_iface() {
	_u=$(nvram get wgs_unit 2>/dev/null)
	case "$_u" in ''|*[!0-9]*) return 1 ;; esac
	echo "wgs$_u"
}

should_run_wireguard() {
	_en=$(nvram get wgs_enable 2>/dev/null)
	case "$_en" in
		1) ;;
		0) SR_WHY="wgs_enable=0 — WireGuard server deliberately off"; return 1 ;;
		*) SR_WHY="wgs_enable unreadable"; return 2 ;;
	esac
	wgif=$(wgs_iface) || { SR_WHY="wgs_unit unreadable"; return 2; }
	return 0
}

is_ok_wireguard() {
	if wg show "$wgif" >/dev/null 2>&1; then
		OK_WHY="$wgif up"; return 0
	fi
	OK_WHY="wgs_enable=1 but interface $wgif does not exist"; return 1
}

repair_wireguard() { svc restart_wgs; }

# ===========================================================================
# CHECK: dnsmasq — DNS/DHCP for the whole LAN
# ===========================================================================
# There is no dnsmasq_enable nvram key, so intent is inferred from sw_mode:
# only a router (sw_mode=1) is expected to run it. Anything else — or an
# unreadable value — is a skip, not a guess.
should_run_dnsmasq() {
	_m=$(nvram get sw_mode 2>/dev/null)
	case "$_m" in
		1) return 0 ;;
		2|3) SR_WHY="sw_mode=$_m (not router mode)"; return 1 ;;
		*) SR_WHY="sw_mode unreadable"; return 2 ;;
	esac
}

is_ok_dnsmasq() {
	if have_proc dnsmasq; then OK_WHY="dnsmasq running"; return 0; fi
	OK_WHY="sw_mode=1 but no dnsmasq process"; return 1
}

repair_dnsmasq() { svc restart_dnsmasq; }

# ===========================================================================
# Opt-in checks
# ===========================================================================
should_run_samba() {
	case "$(nvram get enable_samba 2>/dev/null)" in
		1) return 0 ;; 0) SR_WHY="enable_samba=0"; return 1 ;;
		*) SR_WHY="enable_samba unreadable"; return 2 ;;
	esac
}
is_ok_samba() {
	have_proc smbd && { OK_WHY="smbd running"; return 0; }
	OK_WHY="enable_samba=1 but no smbd process"; return 1
}
repair_samba() { svc restart_samba; }

should_run_upnp() {
	case "$(nvram get upnp_enable 2>/dev/null)" in
		1) return 0 ;; 0) SR_WHY="upnp_enable=0"; return 1 ;;
		*) SR_WHY="upnp_enable unreadable"; return 2 ;;
	esac
}
is_ok_upnp() {
	have_proc miniupnpd && { OK_WHY="miniupnpd running"; return 0; }
	OK_WHY="upnp_enable=1 but no miniupnpd process"; return 1
}
repair_upnp() { svc restart_upnp; }

# ntpd has no enable gate; a router always runs it. Opt-in because a stale
# clock is an annoyance, not an outage — and stop_ntpd is the thing that
# wedges, so poking it during a wedge is the least useful thing we could do.
should_run_ntpd() { return 0; }
is_ok_ntpd() {
	have_proc ntp && { OK_WHY="ntp running"; return 0; }
	OK_WHY="no ntp process"; return 1
}
repair_ntpd() { svc restart_ntpd; }

# ===========================================================================
# Framework
# ===========================================================================
check_enabled() {
	for _c in $HEAL_CHECKS; do [ "$_c" = "$1" ] && return 0; done
	return 1
}

# run_check <name> -> STATE=ok|broken|skip, WHY=...
STATE=""; WHY=""
run_check() {
	_n="$1"; SR_WHY=""; OK_WHY=""
	should_run_"$_n"
	case "$?" in
		1) STATE=skip;  WHY="$SR_WHY"; return ;;
		2) STATE=skip;  WHY="indeterminate: $SR_WHY"; return ;;
	esac
	if is_ok_"$_n"; then STATE=ok; WHY="$OK_WHY"; else STATE=broken; WHY="$OK_WHY"; fi
}

# --- per-check rate limiting ----------------------------------------------
heals_in_window() {
	_f="$RUN/$1.healtimes"
	[ -f "$_f" ] || { echo 0; return; }
	_cut=$(( $(now) - WINDOW )); _n=0
	while read -r t; do
		[ -z "$t" ] && continue
		[ "$t" -gt "$_cut" ] 2>/dev/null && _n=$((_n + 1))
	done < "$_f"
	echo "$_n"
}

record_heal() {
	_f="$RUN/$1.healtimes"; _cut=$(( $(now) - WINDOW )); _tmp="$_f.tmp"
	: > "$_tmp"
	if [ -f "$_f" ]; then
		while read -r t; do
			[ -z "$t" ] && continue
			[ "$t" -gt "$_cut" ] 2>/dev/null && echo "$t" >> "$_tmp"
		done < "$_f"
	fi
	now >> "$_tmp"; mv "$_tmp" "$_f"; now > "$RUN/$1.lastheal"
}

# repair_check <name> — assumes STATE=broken and rate limits already cleared
repair_check() {
	_n="$1"
	_detected="$WHY"
	log "REPAIR[$_n]: $WHY — running repair"
	hist "$_n" "DETECTED" "$_detected"
	record_heal "$_n"
	repair_"$_n"
	sleep "$RECHECK_WAIT"
	run_check "$_n"
	case "$STATE" in
		ok)   log "REPAIR OK[$_n]: $WHY"; hist "$_n" "REPAIRED" "$WHY"; return 0 ;;
		skip) log "REPAIR INCONCLUSIVE[$_n]: $WHY"; hist "$_n" "INCONCLUSIVE" "$WHY"; return 1 ;;
	esac
	log "REPAIR FAILED[$_n]: still broken — $WHY"
	hist "$_n" "FAILED" "still broken after repair — $WHY"

	# Reboot escalation is deliberately tied to the firewall check only: it is
	# the one whose failure takes the entire LAN offline, and rebooting for a
	# stopped Samba would be wildly disproportionate.
	[ "$_n" = "firewall" ] || return 1

	if [ ! -f "$REBOOT_FLAG" ]; then
		log "ESCALATION DISABLED: create $REBOOT_FLAG to permit reboot escalation. Manual action required."
		hist "$_n" "NEEDS-HUMAN" "repair failed; reboot escalation is disabled"
		return 1
	fi
	_age=$(( $(now) - $(read_ts "$PERSIST_REBOOT") ))
	if [ "$_age" -lt "$REBOOT_MIN_GAP" ]; then
		log "ESCALATION SUPPRESSED: last escalated reboot ${_age}s ago (< $REBOOT_MIN_GAP). Manual action required."
		hist "$_n" "NEEDS-HUMAN" "repair failed; reboot suppressed (last was ${_age}s ago)"
		return 1
	fi
	log "ESCALATING: rebooting (restart_firewall did not resolve the fault)"
	hist "$_n" "REBOOTING" "repair did not resolve the fault; escalating to reboot"
	now > "$PERSIST_REBOOT"; sync; reboot
	return 1
}

ALL_CHECKS="firewall wireguard dnsmasq samba upnp ntpd"

# --- subcommands -----------------------------------------------------------
cmd_check() {
	_rc=0; _any_unknown=0
	for c in $ALL_CHECKS; do
		check_enabled "$c" || continue
		run_check "$c"
		case "$STATE" in
			ok)     printf 'OK      %-10s %s\n' "$c" "$WHY" ;;
			broken) printf 'BROKEN  %-10s %s\n' "$c" "$WHY"; _rc=1 ;;
			skip)   printf 'SKIP    %-10s %s\n' "$c" "$WHY"; _any_unknown=1 ;;
		esac
	done
	[ "$_rc" = "1" ] && return 1
	[ "$_any_unknown" = "1" ] && return 2
	return 0
}

cmd_status() {
	unit=$(active_unit) || unit="?"
	say "nat-doctor $VERSION"
	say ""
	say "active checks     : $HEAL_CHECKS"
	say "available         : $ALL_CHECKS"
	say ""
	say "active WAN unit   : $unit"
	say "proto             : $(nvram get wan${unit}_proto 2>/dev/null)"
	say "state_t           : $(nvram get wan${unit}_state_t 2>/dev/null) (2 = connected)"
	say "netdev            : $(active_ifname "$unit" 2>/dev/null || echo '<undetermined>')"
	say "VSERVER rules     : $(vserver_rule_count)"
	say ""
	say "POSTROUTING:"
	iptables -t nat -S POSTROUTING 2>/dev/null | sed 's/^/  /'
	say ""
	for c in $ALL_CHECKS; do
		check_enabled "$c" || continue
		printf '  %-10s heals %s/%s  last %s\n' "$c" "$(heals_in_window "$c")" "$MAXHEALS" "$(read_ts "$RUN/$c.lastheal")"
	done
	say ""
	say "last esc. reboot  : $(read_ts "$PERSIST_REBOOT")"
	say "reboot escalation : $([ -f "$REBOOT_FLAG" ] && echo enabled || echo 'disabled (default)')"
	say "watchdog cron     : $(cru l 2>/dev/null | grep -c nat-doctor-wd) entry/entries"
	if [ -s "$HISTORY" ]; then
		say ""
		say "recent repairs (natctl history for all):"
		tail -3 "$HISTORY" | sed 's/^/  /'
	else
		say "repairs recorded  : none since install"
	fi
	say ""
	cmd_check
}

cmd_log() {
	if [ -f /tmp/syslog.log ]; then grep "$TAG" /tmp/syslog.log | tail -40
	else logread 2>/dev/null | grep "$TAG" | tail -40; fi
}

# The durable record. Unlike `log`, this survives syslog rotation — which is
# the only way to answer "has this thing ever actually done anything?" weeks
# after the fact.
cmd_history() {
	if [ ! -s "$HISTORY" ]; then
		say "No repairs recorded."
		say ""
		say "That is the expected state: nat-doctor writes here ONLY when it"
		say "actually repairs something, never on a healthy check. An empty"
		say "history means the fault has not occurred since installation."
		return 0
	fi
	say "Repairs recorded in $HISTORY (newest last):"
	say ""
	cat "$HISTORY"
	say ""
	say "$(grep -c 'REPAIRED' "$HISTORY" 2>/dev/null) successful repair(s), $(grep -c 'FAILED\|NEEDS-HUMAN\|STAND-DOWN' "$HISTORY" 2>/dev/null) needing attention."
}

cmd_watchdog() {
	# Single instance. A repair takes RECHECK_WAIT seconds while cron fires
	# every minute; overlapping runs must never stack service restarts.
	# PID + /proc, never `ps | grep` — a broad grep can match the calling SSH
	# session (see AGENTS.md).
	# The lock records its START TIME as well as its pid, so a HUNG holder can
	# be told apart from a busy one. Without that, a single wedged `service`
	# call would hold the lock forever and silently disable the watchdog — the
	# worst possible failure, because everything would look installed and fine.
	if [ -f "$LOCK" ]; then
		read -r _pid _lts < "$LOCK" 2>/dev/null
		if [ -n "$_pid" ] && [ -d "/proc/$_pid" ]; then
			_age=$(( $(now) - ${_lts:-0} ))
			if [ "$_age" -lt "$LOCK_STALE" ]; then
				return 0
			fi
			log "STALE LOCK: pid $_pid has held the lock ${_age}s (> $LOCK_STALE) — assuming hung, killing it and taking over"
			kill -KILL "$_pid" 2>/dev/null
		fi
	fi
	echo "$$ $(now)" > "$LOCK"
	trap 'rm -f "$LOCK"' EXIT INT TERM

	for c in $ALL_CHECKS; do
		check_enabled "$c" || continue
		_el=$(run_elapsed)
		if [ "$_el" -ge "$MAX_RUN" ]; then
			log "DEADLINE: run has taken ${_el}s (>= $MAX_RUN) — abandoning remaining checks, will retry next minute"
			break
		fi
		run_check "$c"
		[ "$STATE" = "broken" ] || continue

		_since=$(( $(now) - $(read_ts "$RUN/$c.lastheal") ))
		if [ "$_since" -lt "$COOLDOWN" ]; then
			log "SKIP[$c]: broken ($WHY) but last repair ${_since}s ago (< $COOLDOWN)"
			continue
		fi
		_n=$(heals_in_window "$c")
		if [ "$_n" -ge "$MAXHEALS" ]; then
			log "STANDING DOWN[$c]: $_n repairs in ${WINDOW}s and still broken ($WHY). Manual action required."
			hist "$c" "STAND-DOWN" "$_n repairs in ${WINDOW}s, still broken — $WHY"
			continue
		fi
		repair_check "$c"
	done
}

cmd_heal() {
	_target="$1"
	for c in $ALL_CHECKS; do
		[ -n "$_target" ] && [ "$c" != "$_target" ] && continue
		[ -n "$_target" ] || check_enabled "$c" || continue
		run_check "$c"
		case "$STATE" in
			broken) repair_check "$c" ;;
			*)      say "skip $c: $STATE — $WHY" ;;
		esac
	done
}

case "$1" in
	check)    cmd_check ;;
	status)   cmd_status ;;
	log)      cmd_log ;;
	history)  cmd_history ;;
	watchdog) cmd_watchdog ;;
	heal)     cmd_heal "$2" ;;
	version)  say "nat-doctor $VERSION" ;;
	*)
		say "natctl $VERSION — nat-doctor for Asuswrt-Merlin"
		say ""
		say "usage: natctl {check|status|log|history|watchdog|heal [check]|version}"
		say ""
		say "  check       report every active check (0=all ok 1=broken 2=some unknown)"
		say "  status      full diagnostic dump + check"
		say "  log         recent nat-doctor syslog lines (rotates in ~1 day)"
		say "  history     durable record of every repair ever made"
		say "  watchdog    cron entrypoint: check each, repair what is broken"
		say "  heal [name] force a repair now (ignores cooldown); optionally one check"
		say ""
		say "  checks: $ALL_CHECKS"
		say "  active: $HEAL_CHECKS   (set HEAL_CHECKS in $CONF)"
		exit 2 ;;
esac
